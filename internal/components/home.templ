package components

import "racket/internal/db"

templ Home(machines []db.Machine, parts []db.Part) {
	@Base("Home") {
		<div class="hero">
			<h1>Racket</h1>
			<p class="lead">Keep track of your hardware across every machine.</p>
		</div>
		<div class="dashboard">
			<div class="stat-card">
				<h2>{ itoaInt(len(machines)) }</h2>
				<p>Machines</p>
				<a class="btn" href="/machines">Manage</a>
			</div>
			<div class="stat-card">
				<h2>{ itoaInt(len(parts)) }</h2>
				<p>Parts</p>
				<a class="btn" href="/parts">Manage</a>
			</div>
		</div>
	}
}
