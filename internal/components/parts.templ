package components

import "racket/internal/db"

templ PartsIndex(parts []db.Part, machines []db.Machine) {
	@Base("Parts") {
		<div class="page-header">
			<h1>Parts</h1>
			<button class="btn" hx-get="/parts/new" hx-target="#part-form" hx-swap="innerHTML">Add Part</button>
		</div>
		<div id="part-form"></div>
		<div id="parts-list" class="card-grid">
			@PartList(parts)
		</div>
	}
}

templ PartList(parts []db.Part) {
	for _, p := range parts {
		@PartCard(p)
	}
}

templ PartCard(p db.Part) {
	<article class="card" id={ "part-" + itoa(p.ID) }>
		<h2>{ p.Name }</h2>
		<p class="muted">{ formatString(p.Category) } · { formatString(p.Manufacturer) }</p>
		<dl class="stats">
			<dt>Model</dt>
			<dd>{ formatString(p.Model) }</dd>
			<dt>Serial</dt>
			<dd>{ formatString(p.SerialNumber) }</dd>
			<dt>Purchased</dt>
			<dd>{ formatDate(p.PurchasedOn) }</dd>
			<dt>Price</dt>
			<dd>{ formatPrice(p.PurchasePrice) }</dd>
			<dt>Warranty Expires</dt>
			<dd>{ formatDate(p.WarrantyExpires) }</dd>
		</dl>
		<div class="actions">
			<a class="btn" href={ templ.SafeURL("/parts/" + itoa(p.ID)) }>View</a>
			<button class="btn" hx-get={ "/parts/" + itoa(p.ID) + "/edit" } hx-target="#part-form" hx-swap="innerHTML">Edit</button>
			<button class="btn btn-danger" hx-delete={ "/parts/" + itoa(p.ID) } hx-target={ "#part-" + itoa(p.ID) } hx-swap="outerHTML" hx-confirm="Delete this part?">Delete</button>
		</div>
	</article>
}

templ PartForm(action string, part db.Part, machines []db.Machine, isEdit bool) {
	<form class="form-card" hx-post={ action } hx-target="#parts-list" hx-swap="innerHTML">
		<h3>Part</h3>
		<label>
			Name
			<input type="text" name="name" value={ part.Name } required/>
		</label>
		<label>
			Category
			<input type="text" name="category" value={ formatString(part.Category) } placeholder="e.g. GPU, CPU, Case"/>
		</label>
		<label>
			Machine
			<select name="machine_id">
				<option value="">Unassigned</option>
				for _, m := range machines {
					<option value={ itoa(m.ID) } selected?={ part.MachineID.Valid && part.MachineID.Int64 == m.ID }>{ m.Name }</option>
				}
			</select>
		</label>
		<label>
			Description
			<textarea name="description">{ formatString(part.Description) }</textarea>
		</label>
		<label>
			Manufacturer
			<input type="text" name="manufacturer" value={ formatString(part.Manufacturer) }/>
		</label>
		<label>
			Model
			<input type="text" name="model" value={ formatString(part.Model) }/>
		</label>
		<label>
			Serial Number
			<input type="text" name="serial_number" value={ formatString(part.SerialNumber) }/>
		</label>
		<label>
			Purchased On
			<input type="date" name="purchased_on" value={ formatDate(part.PurchasedOn) }/>
		</label>
		<label>
			Purchased From
			<input type="text" name="purchased_from" value={ formatString(part.PurchasedFrom) }/>
		</label>
		<label>
			Purchase Price
			<input type="number" name="purchase_price" step="0.01" value={ formatPriceValue(part.PurchasePrice) }/>
		</label>
		<label>
			Warranty Expires
			<input type="date" name="warranty_expires" value={ formatDate(part.WarrantyExpires) }/>
		</label>
		<label>
			Guide URL
			<input type="url" name="guide_url" value={ formatString(part.GuideUrl) }/>
		</label>
		if isEdit {
			<input type="hidden" name="id" value={ itoa(part.ID) }/>
			<button class="btn" type="submit" hx-put={ action }>Update</button>
		} else {
			<button class="btn" type="submit">Add Part</button>
		}
	</form>
}

templ PartDetail(part db.Part, machine db.Machine) {
	@Base(part.Name) {
		<div class="page-header">
			<h1>{ part.Name }</h1>
			<a class="btn" href="/parts">Back</a>
		</div>
		<div class="card">
			<p>{ formatString(part.Description) }</p>
			<dl class="stats">
				<dt>Category</dt>
				<dd>{ formatString(part.Category) }</dd>
				<dt>Manufacturer</dt>
				<dd>{ formatString(part.Manufacturer) }</dd>
				<dt>Model</dt>
				<dd>{ formatString(part.Model) }</dd>
				<dt>Serial Number</dt>
				<dd>{ formatString(part.SerialNumber) }</dd>
				<dt>Machine</dt>
				<dd>
					if machine.ID != 0 {
						<a href={ templ.SafeURL("/machines/" + itoa(machine.ID)) }>{ machine.Name }</a>
					} else {
						Unassigned
					}
				</dd>
				<dt>Purchased On</dt>
				<dd>{ formatDate(part.PurchasedOn) }</dd>
				<dt>Purchased From</dt>
				<dd>{ formatString(part.PurchasedFrom) }</dd>
				<dt>Purchase Price</dt>
				<dd>{ formatPrice(part.PurchasePrice) }</dd>
				<dt>Warranty Expires</dt>
				<dd>{ formatDate(part.WarrantyExpires) }</dd>
				if part.GuideUrl.Valid {
					<dt>Guide</dt>
					<dd><a href={ templ.SafeURL(part.GuideUrl.String) } target="_blank">Manual</a></dd>
				}
			</dl>
		</div>
	}
}
