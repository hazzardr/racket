# Racket runtime configuration. Copy to .env; mise loads it for every task.

# SQLite database file path (default: racket.db)
RACKET_DB=racket.db

# Address to listen on (default: empty, every interface). Set 127.0.0.1
# behind a reverse proxy or tunnel so only the proxy can reach the app.
# RACKET_HOST=127.0.0.1

# HTTP server port (default: 8080)
PORT=8080

# The URL people reach Racket at (default: http://localhost:$PORT). Discord
# redirects back to $RACKET_BASE_URL/auth/discord/callback, and https here
# makes cookies HTTPS-only.
RACKET_BASE_URL=http://localhost:8080

# Header holding the client's address, set by a reverse proxy, for the
# request log. Only for a proxy that always overwrites it, on a server only
# the proxy can reach: Cf-Connecting-IP behind Cloudflare. Unset: the
# connection's address.
# RACKET_CLIENT_IP_HEADER=Cf-Connecting-IP

# Discord sign-in. Create an application at
# https://discord.com/developers/applications, then under OAuth2 copy the
# client ID and secret and add the redirect URL above. The guild ID is your
# server's ID (Developer Mode on, right-click the server, Copy Server ID);
# only its members can sign in. Set all three, or none.
RACKET_DISCORD_CLIENT_ID=
RACKET_DISCORD_CLIENT_SECRET=
RACKET_DISCORD_GUILD_ID=

# Dev login: sign in as any username, no Discord. For local development only;
# refused when RACKET_BASE_URL is https. `mise run dev` turns it on.
# RACKET_DEV_LOGIN=1

# GoReleaser token for publishing releases to Forgejo (code.brihome.me), for a
# local `goreleaser release`. CI reads it from the `goreleaser_token` secret.
GITEA_TOKEN=
