# Racket runtime configuration

# SQLite database file path (default: racket.db)
RACKET_DB=racket.db

# HTTP server port (default: 8080)
PORT=8080

# GoReleaser token for publishing releases to Codeberg.
# Generate at: https://codeberg.org/user/settings/applications
# This is consumed by Woodpecker CI as the secret `gitea_token`.
GITEA_TOKEN=
